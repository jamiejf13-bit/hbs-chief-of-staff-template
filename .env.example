# Copy to .env.local in the project folder. The worker on your laptop and
# `npm run dev` both read it. Never commit .env.local — it is in .gitignore.
# Nothing marked LOCAL ONLY may ever be set in Vercel's dashboard.

# ---------- web app (Vercel AND .env.local) ----------

# Neon Postgres connection string (docs/neon-setup.md). Needed on both sides:
# the web app reads it, and the worker writes straight into the database.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The single password you type to open the dashboard.
# Long and random — this is the only thing between the internet and your data.
APP_PASSWORD=

# Secret used to sign the session cookie. 32+ random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Reserved for a worker that talks to the app over HTTP. Today's worker writes
# to the database directly, so nothing checks this yet — set it anyway (same
# way as SESSION_SECRET) so the deployment matches the setup guide.
WORKER_TOKEN=

# Optional: your own Anthropic API key. From console.anthropic.com -> API Keys.
# In Vercel it powers the built-in assistant (the chat box); in .env.local it
# lets the worker estimate how long each to-do will take. Without it the rest
# of the console works and the chat says it is not configured.
ANTHROPIC_API_KEY=

# Ships false. Flip only after drafts have been consistently right for weeks.
EMAIL_SEND_ENABLED=false

# ---------- worker (LOCAL ONLY) ----------

# Your Vercel deployment URL. Informational for now (see WORKER_TOKEN).
API_BASE_URL=https://your-app.vercel.app

# Canvas personal access token.
# hbs.instructure.com -> Account -> Settings -> New Access Token
CANVAS_TOKEN=
CANVAS_BASE_URL=https://hbs.instructure.com

# Google OAuth — see docs/google-setup.md.
# The refresh token itself lives at worker/.credentials/google-token.json, not here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Off by default. gmail.readonly is a *restricted* scope: harmless while the
# app is in Testing, but it blocks publishing to production. Set true and
# re-run `npm run worker:google-auth` to let the console read Gmail.
GOOGLE_GMAIL_SCOPE=false

# Off by default. Lets the worker upload class-prep docs to a Drive folder it
# creates (drive.file scope: it can only see files it made). Same re-run rule.
GOOGLE_DRIVE_SCOPE=false

# Optional: path to your participation tracker .xlsx (a "Class Log" tab).
# Overrides participation.path in lib/profile.json. Leave empty to skip.
PARTICIPATION_XLSX=

# HBS Outlook and 12Twenty use Playwright browser sessions stored under
# worker/.sessions/. No passwords are stored anywhere — you sign in once,
# interactively, and the session persists.
